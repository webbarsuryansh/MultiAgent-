# ---------- Required ----------
MONGODB_URI=mongodb://127.0.0.1:27017/multi-agent
# 32+ random characters each. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
ENCRYPTION_KEY=

# ---------- Server ----------
PORT=5000
CLIENT_ORIGIN=http://localhost:5173
# The account registered with this email becomes an admin (can add models, edit built-in agents)
ADMIN_EMAIL=
# Set to 1 when running behind a reverse proxy (nginx, Render, Railway...)
# TRUST_PROXY=1

# ---------- Admin-managed provider keys (optional; users can also bring their own) ----------
# Leave blank to skip. Set ALLOW_SERVER_KEYS=false to force every user to bring their own key.
ALLOW_SERVER_KEYS=true
GEMINI_API_KEY=
OPENROUTER_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GROQ_API_KEY=
DEEPSEEK_API_KEY=
HF_API_TOKEN=
# Local models: set OLLAMA_ENABLED=true when `ollama serve` is running
OLLAMA_ENABLED=false
OLLAMA_BASE_URL=http://localhost:11434/v1

# ---------- Tuning ----------
MAX_CONCURRENT_AGENTS=6
MAX_AGENTS_PER_REQUEST=6
MAX_COLLAB_ROUNDS=3
PROVIDER_MAX_RETRIES=2
# false = route with keyword rules only (saves one cheap LLM call per prompt)
ROUTER_USE_LLM=true
